# Copy this file to .env and fill in real values. NEVER commit .env itself.

# ── Database ──────────────────────────────────────────────────────────────────
# The app reads DATABASE_URL first, then falls back to POSTGRES_URL.
#
# Local dev — Supabase direct connection (port 5432):
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
#
# Production (Vercel) — Supabase transaction pooler (port 6543):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres
#
# Legacy local Postgres (only if not using Supabase):
# POSTGRES_URL=postgres://postgres:postgres@localhost:54322/postgres

# ── App ───────────────────────────────────────────────────────────────────────
# Local dev URL; override in Vercel with your real deployment URL
BASE_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional: used by some tooling (no longer needed for auth; Supabase Auth handles sessions)
# AUTH_SECRET=replace-with-a-random-secret

# Vercel Cron Jobs — set in Vercel dashboard (min 16 chars). Required for cron to run.
# CRON_SECRET=replace-with-random-secret-for-cron

# ── Supabase (Auth, Storage) ───────────────────────────────────────────────────
# Project URL (public)
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
# Anon key (public, for Auth in browser and server) — Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...   # or NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# Service role key (secret, server-side only) — for admin ops, storage, seed
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Set EMAIL_PROVIDER=resend to enable real emails; otherwise logs to console
# Contacts are synced to Resend on sign-in/sign-up for Broadcasts
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_replace_with_your_key
EMAIL_FROM=Easy Rent <noreply@yourdomain.com>
# OPS_EMAIL=ops@yourdomain.com

# ── Optional services ─────────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_live_***
# STRIPE_WEBHOOK_SECRET=whsec_***

# WhatsApp number for the concierge-listing funnel ("WhatsApp us 6 photos").
# Digits with country code; concierge CTAs hide themselves when unset.
# NEXT_PUBLIC_WHATSAPP_SUPPORT=94771234567

# ── WhatsApp Business Cloud API (automated intake pipeline) ─────────────────
# All from Meta for Developers → your app → WhatsApp. Pipeline stays dormant
# until ALL are set. VERIFY_TOKEN is a value you invent and paste into the
# webhook config; APP_SECRET signs webhook payloads (X-Hub-Signature-256).
# WHATSAPP_VERIFY_TOKEN=invent-a-random-string
# WHATSAPP_APP_SECRET=from-meta-app-settings
# WHATSAPP_ACCESS_TOKEN=permanent-system-user-token
# WHATSAPP_PHONE_NUMBER_ID=1234567890
# Intake parsing is rule-based and in-process (lib/intake/parser) — no API key
# needed. The optional LLM fallback behind the enableLlmParserFallback flag
# reuses SILICONFLOW_API_KEY (below), the same key the moderation engine uses;
# there is no separate provider or key to set up.
# INTAKE_LLM_MODEL=Qwen/Qwen3-8B
# Test seam: set to 0 on a local/staging target so the processing cron picks
# up intakes immediately instead of after the 10-min settle window. Never in prod.
# INTAKE_SETTLE_MS=0
